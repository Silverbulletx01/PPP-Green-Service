# Server
PORT=3000
HTTPS_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# CORS - comma-separated list of allowed origins (leave empty to allow same-origin only)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ppp_green_service

# JWT Auth - IMPORTANT: Change this to a strong random secret (min 32 characters)
JWT_SECRET=CHANGE-ME-use-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# Device auth key for Android data ingestion endpoint (/api/v1/android/data)
DEVICE_API_KEY=CHANGE-ME-strong-device-api-key

# PPP WiFi restriction for Android ingest API
# Set to true to only allow device submissions from configured PPP WiFi IPv4 networks.
PPP_WIFI_ENFORCE=false
# Comma-separated IPv4 CIDRs or IPs, for example: 172.16.0.0/24,10.10.10.10
PPP_WIFI_ALLOWED_CIDRS=
# Keep true to allow localhost for local testing.
PPP_WIFI_ALLOW_LOCALHOST=true

# Default Admin (created on first run) - IMPORTANT: Use a strong password (min 8 characters)
ADMIN_EMAIL=admin@pppgc.co.th
ADMIN_PASSWORD=CHANGE-ME-use-a-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=System
